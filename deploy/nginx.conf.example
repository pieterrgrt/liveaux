# /etc/nginx/sites-available/liveaux  (then symlink into sites-enabled)
# Test and reload:  sudo nginx -t && sudo systemctl reload nginx
# HTTPS certificate: sudo certbot --nginx -d liveaux.eu -d www.liveaux.eu

server {
    listen 80;
    server_name liveaux.eu www.liveaux.eu;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Django needs this to know the visitor came in over HTTPS.
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
