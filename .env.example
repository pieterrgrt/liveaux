# Copy to .env on the server and fill in. Never commit the real .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=liveaux.eu,www.liveaux.eu
# Letters and digits only (it goes into a URL). Make one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-too
# Local port the app listens on (127.0.0.1 only). Change if 8001 is taken.
LIVEAUX_PORT=8001

# Email for sign-up confirmation and password resets (SMTP).
# Leave EMAIL_HOST empty (or a placeholder like smtp.example.com) and there's no mail server:
# emails are only printed in the logs, people sign up and log in straight away,
# and the password-reset page says it can't send a link.
DEFAULT_FROM_EMAIL=liveaux <noreply@liveaux.eu>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Confirm the email address before logging in: mandatory, optional or none.
# Leave empty for the default: mandatory with a real mail server, optional without.
ACCOUNT_EMAIL_VERIFICATION=

# Who gets an email when a venue submits an event (comma-separated).
DJANGO_ADMIN_EMAILS=

# Address for privacy questions, shown in the privacy statement.
LIVEAUX_CONTACT_EMAIL=privacy@liveaux.eu

# The library. Everything works without keys: films come from Wikidata/Wikipedia, series from TVmaze,
# games from Wikidata. With a TMDB key (themoviedb.org → Settings → API, free) films and series come
# from TMDB, with recommendations and TMDB scores; with a Twitch developer app games come from IGDB.
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
